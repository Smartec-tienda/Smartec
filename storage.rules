rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // HELPERS
    // ============================================================
    function isAuth() {
      return request.auth != null;
    }
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function userRole() {
      return isAuth() ? userDoc().role : null;
    }
    function userStore() {
      return isAuth() ? userDoc().storeId : null;
    }
    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }
    function isStoreAdmin() {
      return isAuth() && userRole() == 'admin';
    }
    function isStaff() {
      return isAuth() && userRole() in ['superadmin','admin','vendedor'];
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*|application/pdf');
    }
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ============================================================
    // EXPENSES (soportes contables)
    // ============================================================
    match /expenses/{storeId}/{fileName} {
      allow read: if isSuperAdmin()
                  || (isStaff() && userStore() == storeId);
      allow write: if isSuperAdmin()
                   || (isStoreAdmin() && userStore() == storeId)
                   && isUnder5MB()
                   && isImageOrPdf();
    }

    // ============================================================
    // PRODUCTS (fotos del catálogo)
    // ============================================================
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAuth()
                   && isUnder5MB()
                   && isImage();
    }
    // ============================================================
    // SETTINGS (logo y otros recursos de identidad visual)
    // ============================================================
    match /settings/{fileName} {
      allow read: if true;
      allow write: if isAuth()
                   && isUnder5MB()
                   && request.resource.contentType.matches('image/.*');
    }
    // ============================================================
    // WARRANTIES (adjuntos de garantías)
    // ============================================================
    match /warranties/{storeId}/{fileName} {
      allow read: if isSuperAdmin()
                  || (isStaff() && userStore() == storeId);
      allow write: if isSuperAdmin()
                   || (isStaff() && userStore() == storeId)
                   && isUnder5MB()
                   && isImageOrPdf();
    }

    // ============================================================
    // DOCUMENTS (PDFs de venta: remisión, tirilla, media carta)
    // Ruta: documents/{storeId}/{saleId}/{fileName}
    // ============================================================
    match /documents/{storeId}/{saleId}/{fileName} {
      allow read: if isSuperAdmin()
                  || (isStaff() && userStore() == storeId);

      allow write: if (isSuperAdmin()
                   || (isStaff() && userStore() == storeId))
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // ============================================================
    // CUALQUIER OTRA CARPETA → bloqueada por defecto
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}